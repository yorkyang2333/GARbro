<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GARbro.Avalonia.Views.ErrorDialog"
        Title="Error" Width="400" Height="200" WindowStartupLocation="CenterOwner" CanResize="False">
    <StackPanel Margin="20" Spacing="20">
        <TextBlock Name="MessageText" TextWrapping="Wrap" Text="An error occurred." />
        <Button Content="OK" HorizontalAlignment="Center" Click="OkButton_Click" />
    </StackPanel>
</Window>
