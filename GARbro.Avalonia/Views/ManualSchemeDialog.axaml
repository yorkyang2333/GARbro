<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GARbro.Avalonia.Views.ManualSchemeDialog"
        Title="Encrypted Archive"
        Width="400" Height="250"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    
    <StackPanel Margin="20" Spacing="15">
        <TextBlock Name="NoticeTextBlock" TextWrapping="Wrap" />
        
        <TextBlock Text="Select Decryption Scheme:" FontWeight="Bold"/>
        <ComboBox Name="SchemeComboBox" HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" MaxWidth="300" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        
        <CheckBox Name="SaveSchemeCheckBox" Content="Remember selected scheme" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,20,0,0">
            <Button Name="AutoDetectButton" Content="Auto-Detect" Click="AutoDetectButton_Click" Background="#2196F3" Foreground="White" />
            <Button Name="OkButton" Content="OK" Click="OkButton_Click" />
            <Button Name="CancelButton" Content="Cancel" Click="CancelButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
